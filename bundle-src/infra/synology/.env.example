# Telegram application credentials from https://my.telegram.org/apps
# One pair is shared by fast-mcp-telegram and Local Telegram Bot API.
API_ID=
API_HASH=

# fast-mcp-telegram HTTP setup / attachment URL hostname when applicable.
# For initial private read-only testing this may remain localhost.
DOMAIN=localhost

# Optional phone fallback. QR setup is preferred.
# PHONE_NUMBER=+31...

# Future owner-bot token. Not required until the owner-bot plane is activated.
# OWNER_BOT_TOKEN=
# OWNER_TELEGRAM_USER_ID=
# OWNER_TELEGRAM_CHAT_ID=

# OpenAI Secure MCP Tunnel.
# Create the tunnel in Platform tunnel settings.
# The runtime key principal needs Tunnels Read + Use.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# fast-mcp-telegram bearer returned by QR/web setup.
# Keep the literal "Bearer " prefix.
LOCAL_MCP_AUTHORIZATION=
