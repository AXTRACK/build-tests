{
  "name": "nas-chatgpt-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Private Synology DSM MCP server for ChatGPT with a curated, least-privilege tool surface.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "start": "node dist/index.js",
    "start:stdio": "SYNOLOGY_MCP_TRANSPORT=stdio node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.18.0",
    "undici": "7.29.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "typescript": "5.7.3"
  }
}
